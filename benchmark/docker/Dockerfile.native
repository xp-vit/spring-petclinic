FROM ghcr.io/graalvm/native-image-community:25 AS build
RUN microdnf install -y findutils && microdnf clean all
WORKDIR /app
COPY gradlew settings.gradle build.gradle ./
COPY gradle/ gradle/
COPY src/ src/
RUN ./gradlew nativeCompile -x test -x checkstyleMain -x checkstyleTest -x checkstyleNohttp -x checkFormatMain -x checkFormatTest --no-daemon

FROM debian:bookworm-slim
WORKDIR /app
COPY --from=build /app/build/native/nativeCompile/spring-petclinic ./spring-petclinic
EXPOSE 8080
ENTRYPOINT ["./spring-petclinic"]
